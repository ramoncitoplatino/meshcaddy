<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MeshCaddy</AssemblyName>
    <RootNamespace>MeshCaddy</RootNamespace>
    <Product>MeshCaddy</Product>
    <Title>MeshCaddy</Title>
    <Description>A fast Windows browser for 3D model files.</Description>
    <Company>MeshCaddy</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\Brand\meshcaddy.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SLSelectRuntimeId>win-x64</SLSelectRuntimeId>
    <SLSelectAllRuntimes>false</SLSelectAllRuntimes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StirlingLabs.Assimp.Net" Version="23.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Brand\meshcaddy-icon-32.png" />
    <Resource Include="Assets\Brand\meshcaddy-icon-128.png" />
  </ItemGroup>
</Project>
