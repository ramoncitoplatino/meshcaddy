<Window x:Class="MeshCaddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeshCaddy — Your 3D model browser"
        Width="1180" Height="760" MinWidth="820" MinHeight="520" FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" KeyDown="Window_KeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/Brand/meshcaddy-icon-32.png" Width="28" Height="28" Margin="0,0,8,0"/>
                    <TextBlock Text="MeshCaddy" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Open folder" Click="OpenFolder_Click" ToolTip="Choose a folder (Ctrl+O)"/>
                    <Button Content="Refresh" Click="Refresh_Click" ToolTip="Refresh folder (F5)"/>
                </StackPanel>
                <TextBox x:Name="PathBox" Grid.Column="1" Margin="10,3" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox x:Name="ThemeBox" Width="95" SelectedIndex="0" SelectionChanged="ThemeBox_SelectionChanged" ToolTip="Appearance">
                        <ComboBoxItem Content="System" Tag="System"/>
                        <ComboBoxItem Content="Dark" Tag="Dark"/>
                        <ComboBoxItem Content="Light" Tag="Light"/>
                    </ComboBox>
                    <Button Content="Previous" Click="Previous_Click" ToolTip="Previous model (Left)"/>
                    <Button Content="Next" Click="Next_Click" ToolTip="Next model (Right)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="210"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Filter models"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SortBox" SelectionChanged="SortBox_SelectionChanged" SelectedIndex="1"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="7,5">
                                <ComboBoxItem Content="Name" Tag="Name"/>
                                <ComboBoxItem Content="Modified date" Tag="Modified"/>
                                <ComboBoxItem Content="Created date" Tag="Created"/>
                                <ComboBoxItem Content="Size" Tag="Size"/>
                                <ComboBoxItem Content="File type" Tag="Type"/>
                            </ComboBox>
                            <Button x:Name="SortDirectionButton" Grid.Column="1" Content="↓" Click="SortDirection_Click" ToolTip="Reverse sort order" Padding="10,5"/>
                        </Grid>
                        <CheckBox x:Name="SelectAllCheckBox" Content="Select all" Margin="4,8,0,0"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Checked="SelectAllCheckBox_Changed" Unchecked="SelectAllCheckBox_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="FileCountText" DockPanel.Dock="Bottom" Margin="14,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ListBox x:Name="FileList" Margin="8,0" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" SelectionChanged="FileList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                              Checked="FileCheckBox_Changed" Unchecked="FileCheckBox_Changed"/>
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="6" Background="{DynamicResource ButtonBrush}">
                                        <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Column="2" Background="{DynamicResource ViewportBrush}" ClipToBounds="True">
                <Viewport3D x:Name="Viewport" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="Camera" FieldOfView="45"/>
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#55606F"/>
                                <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-2"/>
                                <DirectionalLight Color="#819CB8" Direction="1,0.5,1"/>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D x:Name="ModelVisual"/>
                </Viewport3D>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/meshcaddy-icon-128.png" Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Open a folder and start browsing" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your 3D model browser." Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drag to orbit  •  Mouse wheel to zoom  •  Double-click to fit" Margin="0,8" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="3" IsIndeterminate="True"/>
                        <TextBlock Text="Loading model…" Margin="0,12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ComboBox x:Name="PlateBox" Width="150" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Visibility="Collapsed" SelectionChanged="PlateBox_SelectionChanged" ToolTip="Choose a build plate"/>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{DynamicResource PanelBrush}" CornerRadius="6" Margin="14" Padding="10,7">
                    <TextBlock x:Name="ModelInfoText" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="9,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                <TextBlock x:Name="PreloadStatusText" Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="New folder" Click="NewFolder_Click"/>
                    <Button Content="Rename" Click="Rename_Click"/>
                    <Button Content="Copy to…" Click="Copy_Click"/>
                    <Button Content="Move selected…" Click="Move_Click"/>
                    <Button Content="Recycle selected" Click="Delete_Click"/>
                    <Button Content="Show in Explorer" Click="Reveal_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
